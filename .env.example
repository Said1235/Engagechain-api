# EngageChain API — Environment Variables
# Copy this to .env and fill in your values.
# Never commit .env to git.

# Required: your deployed EngageChain contract address
CONTRACT_ADDRESS=0x15322146FdF38a93F5F4eBB88499A49A2199A6f2

# Optional: GenLayer RPC endpoint (default = studionet)
GENLAYER_RPC=https://studio.genlayer.com:8443/api

# Optional: default private key for signing write transactions
# If not set, a fresh studionet key is auto-generated per request (only works on studionet)
# Callers can also pass X-Private-Key header per request to use their own key
PRIVATE_KEY=0xyour_private_key_here

# Optional: port for server.js (Railway/Heroku set this automatically)
PORT=3000
